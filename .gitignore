# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Virtual environment
.venv/
venv/
env/

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Runtime artifacts
*.lock
*.log
app_error.log
campus_run.lock
run_now.log
run_now.err

# Map tile cache (regenerated at runtime)
_tiles/
_tile_test/

# Local config & routes (machine-specific, contains personal coordinates)
run_config.json
route.json
config.json
.env

# Android artifacts & personal data (NEVER COMMIT)
*.apk
lepao_base.apk
mmkv_dump/
setting_now*
mumu_logged.xml
*.db
*.sqlite3

# Third-party cloned repos (keep local)
assistant/
budaolepao/
run-helper/
yunyundong/

# Screenshots / temp images (all ignored by default)
*.png
*.jpg
*.jpeg
*.xml

# ...except documentation assets
!assets/*.png
!assets/*.jpg